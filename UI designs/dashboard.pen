{
  "version": "2.6",
  "children": [
    {
      "type": "frame",
      "id": "dashboard",
      "x": 0,
      "y": 0,
      "name": "Manager Dashboard",
      "width": 1440,
      "fill": "#FAFAFA",
      "layout": "vertical",
      "children": [
        {
          "type": "frame",
          "id": "topBar",
          "name": "Top Bar",
          "width": "fill_container",
          "height": 80,
          "fill": "#FFFFFF",
          "stroke": {
            "align": "inside",
            "thickness": 1,
            "fill": "#E5E7EB"
          },
          "padding": [
            0,
            80
          ],
          "justifyContent": "space_between",
          "alignItems": "center",
          "children": [
            {
              "type": "image",
              "id": "topBarLogo",
              "name": "logo",
              "src": "/talkio-logo.svg",
              "width": 100,
              "height": 35
